<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="InstaFarma: tu autoservicio de confianza" />

    <title>InstaFarma</title>
    <link rel="icon" type="image/png" href="img/logo.png">
    <link rel="stylesheet" href="css/index.css">

    <!-- Importación de js con 'defer' para que se ejecute luego de que 
     se cargue el HTML -->
    <script src="index.js" defer></script>

    <!-- Importación de fuentes Google Fonts e íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

</head>

<body>
    <header class="header">
        <img class="icono" src="img/logo.png" alt="Icono de InstaFarma">
        <div class="titulo">
            <h1>InstaFarma</h1>
        </div>
    </header>

    <main>
        <section class="titulo">
            <h2>Consulte producto por Id</h2>
        </section>
        <section class="formulario">
            <form id="product-form">
                <label for="idProduct">Id producto</label>
                <input type="number" name="id" id="idProduct" min="1" required>

                <input type="submit" class="boton" value="Buscar">
            </form>
        </section>

        <section id="contenedor-producto">
        </section>
        <section id="update-form" class="formulario">
        </section>
        <section id="errors">
        </section>
    </main>

    <footer class="footer">
        <span>2026 - InstaFarma</span>
    </footer>
</body>

</html>